[Unit]
Description=Agent-browser local approved-plan binding controller (renewal disabled)

[Service]
Type=simple
ExecStart=%h/.local/lib/agent-browser-private-controller/20260909-v1/agent-browser private-controller serve %h/.agent-browser/private-controller
UMask=0077
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX
LimitCORE=0
Restart=no
TimeoutStopSec=5

[Install]
WantedBy=default.target
