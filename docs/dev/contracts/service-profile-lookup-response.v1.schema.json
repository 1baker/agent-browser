{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-browser.local/contracts/service-profile-lookup-response.v1.schema.json",
  "title": "agent-browser service profile lookup response",
  "description": "Stable API shape for server-authoritative service profile identity lookup returned by HTTP service APIs and service observability clients.",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "query",
    "rankedProfiles",
    "selectedRecommendation",
    "selectedProfile",
    "selectedProfileSource",
    "selectedProfileMatch",
    "readiness",
    "readinessSummary",
    "seedingHandoff",
    "notFound"
  ],
  "properties": {
    "schemaVersion": {
      "const": "service-profile-discovery.v1"
    },
    "status": {
      "type": "string",
      "enum": ["matched", "not_found"]
    },
    "query": {
      "type": "object",
      "required": [
        "serviceName",
        "targetServiceIds",
        "accountIds",
        "url",
        "readinessProfileId",
        "browserBuild",
        "profileIds",
        "profileNames",
        "hostnames",
        "authenticationStates",
        "freshnessStates",
        "tags",
        "search"
      ],
      "properties": {
        "serviceName": {
          "type": ["string", "null"]
        },
        "targetServiceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accountIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": ["string", "null"]
        },
        "readinessProfileId": {
          "type": ["string", "null"]
        },
        "browserBuild": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["stock_chrome", "stealthcdp_chromium", "cdp_free_headed"]
            },
            {
              "type": "null"
            }
          ]
        },
        "profileIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "profileNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authenticationStates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "freshnessStates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "search": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "rankedProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "profileId",
          "profile",
          "profileSource",
          "reason",
          "matchedField",
          "matchedIdentity",
          "allocation",
          "recommendation"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "profileId": {
            "type": "string"
          },
          "profile": {
            "$ref": "service-profile-record.v1.schema.json"
          },
          "profileSource": {
            "$ref": "service-profiles-response.v1.schema.json#/$defs/profileSource"
          },
          "reason": {
            "type": "string"
          },
          "matchedField": {
            "type": "string"
          },
          "matchedIdentity": {
            "type": "string"
          },
          "allocation": {
            "type": ["object", "null"]
          },
          "recommendation": {
            "type": "object",
            "required": ["action", "routeAvailable", "serviceRequest", "dashboardUrl"],
            "properties": {
              "action": {
                "type": "string"
              },
              "routeAvailable": {
                "type": "boolean"
              },
              "serviceRequest": {
                "type": "object"
              },
              "dashboardUrl": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "selectedRecommendation": {
      "type": ["object", "null"]
    },
    "selectedProfile": {
      "oneOf": [
        {
          "$ref": "service-profile-record.v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "selectedProfileSource": {
      "oneOf": [
        {
          "$ref": "service-profiles-response.v1.schema.json#/$defs/profileSource"
        },
        {
          "type": "null"
        }
      ]
    },
    "selectedProfileMatch": {
      "oneOf": [
        {
          "type": "object",
          "required": ["profileId", "profile", "reason", "matchedField", "matchedIdentity"],
          "properties": {
            "profileId": {
              "type": "string"
            },
            "profile": {
              "$ref": "service-profile-record.v1.schema.json"
            },
            "reason": {
              "type": "string"
            },
            "matchedField": {
              "type": ["string", "null"]
            },
            "matchedIdentity": {
              "type": ["string", "null"]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "readiness": {
      "oneOf": [
        {
          "$ref": "service-profile-readiness-response.v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "readinessSummary": {
      "type": "object",
      "required": [
        "needsManualSeeding",
        "manualSeedingRequired",
        "targetServiceIds",
        "recommendedActions"
      ],
      "properties": {
        "needsManualSeeding": {
          "type": "boolean"
        },
        "manualSeedingRequired": {
          "type": "boolean"
        },
        "targetServiceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommendedActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "seedingHandoff": {
      "oneOf": [
        {
          "$ref": "service-profile-seeding-handoff-response.v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "notFound": {
      "oneOf": [
        {
          "type": "object",
          "required": ["code", "message", "nextActions"],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "nextActions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true
}
